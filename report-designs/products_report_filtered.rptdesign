            <xml-property name="queryText"><![CDATA[SELECT id, name, category, price
FROM products
WHERE id BETWEEN ? AND ?
  AND name LIKE ?
  AND category LIKE ?
  AND price BETWEEN ? AND ?
ORDER BY id]]></xml-property>
